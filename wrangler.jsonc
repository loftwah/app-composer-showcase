{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composer-showcase",
  "account_id": "1003dc1d93af0ebea56b2f1252f89627",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "showcase.loftwah.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "composer-showcase",
      "database_id": "c366203f-d880-4afc-a78e-d3e607146469",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://showcase.loftwah.com",
    "PROVIDER_ORIGIN": "https://guestbook.loftwah.com",
    "PROVIDER_ID": "guestbook",
    "PROVIDER_MOUNT": "/guestbook"
  },
  "services": [
    {
      "binding": "ITEM_PROVIDER",
      "service": "composer-guestbook"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false
}
