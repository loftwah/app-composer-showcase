{
  "contract": 1,
  "id": "showcase",
  "name": "Top shelf",
  "version": "1.1.0",
  "repository": "https://github.com/loftwah/app-composer-showcase",
  "runtime": "cloudflare-worker",
  "entry": "src/worker.ts",
  "dataVersion": 1,
  "routes": [
    "/showcase"
  ],
  "capabilities": [
    "items:read",
    "features:write"
  ],
  "configuration": {
    "title": {
      "type": "string",
      "default": "Top shelf",
      "maxLength": 80
    },
    "intro": {
      "type": "string",
      "default": "A few things we think you should see.",
      "maxLength": 240
    },
    "theme": {
      "type": "select",
      "options": [
        "daylight",
        "midnight"
      ],
      "default": "daylight"
    },
    "layout": {
      "type": "select",
      "options": [
        "grid",
        "editorial",
        "compact"
      ],
      "default": "grid"
    },
    "handle": {
      "type": "string",
      "default": "",
      "maxLength": 40,
      "format": "handle"
    },
    "website": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "format": "https-url"
    },
    "github": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "format": "https-url",
      "hosts": [
        "github.com"
      ]
    },
    "bluesky": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "format": "https-url",
      "hosts": [
        "bsky.app"
      ]
    },
    "linkedin": {
      "type": "string",
      "default": "",
      "maxLength": 2048,
      "format": "https-url",
      "hosts": [
        "linkedin.com",
        "www.linkedin.com"
      ]
    }
  },
  "cardPresentation": {
    "version": 1,
    "icons": [
      "link",
      "book",
      "code",
      "music",
      "video",
      "heart"
    ]
  }
}
